# ─── AI APIs ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_AVATAR_ID=your_chosen_avatar_id_here    # From HeyGen dashboard

# ─── TTS Provider — set ONE key and the system auto-selects ──────────────────
# Priority order: Sarvam > Google WaveNet > ElevenLabs > edge-tts (always-free fallback)

# OPTION 1 (recommended): Sarvam AI — best FREE option for Indian languages
# Sign up: https://app.sarvam.ai → API Keys
# Free tier, purpose-built for Telugu/Tamil/Kannada/Hindi etc.
SARVAM_API_KEY=your_sarvam_api_key_here
# Voice options (female): meera, pavithra, maitreyi  |  (male): arvind, amol, amartya
# SARVAM_VOICE_TELUGU=meera
# SARVAM_VOICE_HINDI=meera

# OPTION 2: Google Cloud WaveNet — 1,000,000 chars/month FREE (covers all 7 channels daily)
# Setup: https://cloud.google.com/text-to-speech → enable API → service account JSON
# USE_GOOGLE_TTS=true
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# OPTION 3: ElevenLabs — most natural overall, 10,000 chars/month free (~14 videos)
# Sign up: https://elevenlabs.io → Profile → API Key
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVEN_VOICE_TELUGU=9BWtsMINqrJLrRacOk9x

# ─── Talking-avatar videos (local SadTalker) ─────────────────────────────────
# For jobs with `video_style: avatar`. If SADTALKER_DIR is unset, those jobs fall
# back to the standard card video automatically.
SADTALKER_DIR=                 # path to your SadTalker checkout (with inference.py + checkpoints)
SADTALKER_PYTHON=python        # interpreter that runs SadTalker (e.g. its own venv's python)
SADTALKER_ENHANCER=            # optional: gfpgan  (sharper face, slower)
SADTALKER_EXTRA_ARGS=          # optional extra inference.py args
SADTALKER_TIMEOUT=1800         # seconds before giving up on a render

# ─── HeyGen Voice IDs (from HeyGen voice list) ───────────────────────────────
HEYGEN_VOICE_TAMIL=ta-IN-PallaviNeural
HEYGEN_VOICE_TELUGU=te-IN-MohanNeural
HEYGEN_VOICE_KANNADA=kn-IN-SapnaNeural
HEYGEN_VOICE_MALAYALAM=ml-IN-SobhanaNeural
HEYGEN_VOICE_HINDI=hi-IN-SwaraNeural
HEYGEN_VOICE_MARATHI=mr-IN-AarohiNeural
HEYGEN_VOICE_BENGALI=bn-IN-TanishaaNeural

# ─── YouTube Channel IDs ──────────────────────────────────────────────────────
YT_CHANNEL_TAMIL=UCxxxxxxxxxxxxxxxxxxxxxxx
YT_CHANNEL_TELUGU_AP=UCxxxxxxxxxxxxxxxxxxxxxxx
YT_CHANNEL_TELUGU_TS=UCxxxxxxxxxxxxxxxxxxxxxxx
YT_CHANNEL_KANNADA=UCxxxxxxxxxxxxxxxxxxxxxxx
YT_CHANNEL_MALAYALAM=UCxxxxxxxxxxxxxxxxxxxxxxx
YT_CHANNEL_MARATHI=UCxxxxxxxxxxxxxxxxxxxxxxx
YT_CHANNEL_BENGALI=UCxxxxxxxxxxxxxxxxxxxxxxx
YT_CHANNEL_HINDI=UCxxxxxxxxxxxxxxxxxxxxxxx

# ─── YouTube Upload Safety ───────────────────────────────────────────────────
# Default is private. Use unlisted/public only when publishing is intentional.
YOUTUBE_UPLOAD_PRIVACY=private
# Set true to require a per-state approval marker before YouTube upload.
REQUIRE_UPLOAD_APPROVAL=false
UPLOAD_APPROVAL_MARKER=APPROVED_FOR_UPLOAD

# ─── Optional Run Notifications ──────────────────────────────────────────────
# Configure any channel below. Leave blank to disable notifications.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=your_email@example.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=your_email@example.com
# EMAIL_TO=operator@example.com,backup@example.com

# ─── Paths ───────────────────────────────────────────────────────────────────
RUN_OUTPUT_DIR=output/runs
HISTORY_DB_PATH=data/gold_prices.sqlite
SCRAPER_DEBUG_DIR=logs/scraper_debug
LOG_DIR=logs
YOUTUBE_CREDS_DIR=credentials/youtube
